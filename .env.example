# Copy this file to .env.local and fill in the values.

# From https://www.sanity.io/manage (or printed by `npx sanity init`)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# WhatsApp number that receives orders: country code + number, digits only (e.g. 94771234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public address of the live site, used for canonical links, sitemap and social previews.
# Leave empty locally; the deploy workflow sets it from a GitHub repo variable.
NEXT_PUBLIC_SITE_URL=

# ISO currency code used to format prices
NEXT_PUBLIC_CURRENCY=LKR
